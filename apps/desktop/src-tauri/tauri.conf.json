{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kestrel",
  "version": "0.1.0",
  "identifier": "dev.kestrel.explorer",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kestrel",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 420,
        "decorations": false,
        "shadow": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
